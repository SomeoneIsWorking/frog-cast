<?xml version="1.0" encoding="utf-8"?>
<!-- Fyne's generated manifest, plus sharing a link to the app. noHistory
     finishes the activity when it leaves the screen, so a share always
     starts it with the shared intent (Fyne's activity ignores new intents). -->
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="io.frogcast.remote"
	android:versionCode="1"
	android:versionName="1.0.0">

	<application android:label="Frog Cast Remote" android:debuggable="true">
	<activity android:name="org.golang.app.GoNativeActivity"
		android:label="Frog Cast Remote"
		android:configChanges="orientation|keyboardHidden|uiMode"
		android:exported="true"
		android:noHistory="true"
		android:theme="@android:style/Theme">
		<meta-data android:name="android.app.lib_name" android:value="frogcastremote" />
		<intent-filter>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent-filter>
		<intent-filter android:label="Cast with Frog Cast">
			<action android:name="android.intent.action.SEND" />
			<category android:name="android.intent.category.DEFAULT" />
			<data android:mimeType="text/plain" />
		</intent-filter>
	</activity>

	<receiver android:name="org.golang.app.FyneNotificationReceiver"
			  android:exported="false" />
	</application>

	<uses-permission android:name="android.permission.INTERNET" />
</manifest>
